    /* Premium Thematic Overrides and Token Classes */
    :root {
        --coop-gold: #B59410;
        --coop-gold-hover: #91750A;
        --coop-dark: #0F172A;
    }

    #editProductModal .form-control,
    #editProductModal .form-select,
    #editProductModal .input-group-text {
        font-size: 0.875rem;
        padding-top: 0.6rem;
        padding-bottom: 0.6rem;
        border-color: rgba(15, 23, 42, 0.12);
        background-color: #ffffff;
        transition: all 0.15s ease-in-out;
    }

        #editProductModal .form-control:focus,
        #editProductModal .form-select:focus {
            border-color: var(--coop-gold);
            box-shadow: 0 0 0 4px rgba(181, 148, 16, 0.12);
            color: var(--coop-dark);
        }

    #editProductModal .input-group:focus-within .input-group-text {
        border-color: var(--coop-gold);
        color: var(--coop-gold) !important;
    }

    #editProductModal textarea.form-control {
        resize: none;
        line-height: 1.5;
    }

    .btn-coop-save {
        background: linear-gradient(135deg, #C5A422 0%, #91750A 100%);
        color: #FFFFFF !important;
        border: none;
    }

        .btn-coop-save:hover {
            background: linear-gradient(135deg, #D6B533 0%, #A28413 100%);
        }

    .transition-all {
        transition: all 0.2s ease-in-out !important;
    }

    .hover-translate-up {
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

        .hover-translate-up:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(181, 148, 16, 0.25) !important;
        }
</style>