@model List<YellowphaseWebsite.Models.ApplicationUser>

<style>
    /* --- DIRECTORY TABLE SYSTEM ENGINE --- */
    .premium-table-wrapper {
        border: 1px solid #e2e8f0 !important;
        border-radius: 14px !important;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 4px 20px -2px rgba(11, 31, 58, 0.02) !important;
    }

    .modern-dir-table {
        margin-bottom: 0 !important;
        vertical-align: middle;
    }

        .modern-dir-table thead {
            background-color: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
        }

        .modern-dir-table th {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #64748b;
            padding: 1rem 1.25rem !important;
            border-bottom: none !important;
        }

        .modern-dir-table tbody tr {
            transition: all 0.2s ease;
            border-bottom: 1px solid rgba(241, 245, 249, 0.9);
        }

            .modern-dir-table tbody tr:last-child {
                border-bottom: none;
            }

            .modern-dir-table tbody tr:hover {
                background-color: rgba(248, 250, 252, 0.75) !important;
            }

        .modern-dir-table td {
            padding: 1rem 1.25rem !important;
            font-size: 0.9rem;
            color: #334155;
            border-bottom: none !important;
        }

    /* Column Specific Typography Weights */
    .user-identity-cell {
        font-weight: 600;
        color: #0b1f3a !important;
    }

    .user-comms-cell {
        color: #475569;
        font-family: 'SFMono-Regular', Menlo, Monaco, Consolas, monospace;
        font-size: 0.85rem !important;
    }

    /* Core Micro Action Utilities */
    .btn-table-manage {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        color: #475569;
        font-weight: 600;
        font-size: 0.8rem;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        transition: all 0.2s ease;
    }

        .btn-table-manage:hover {
            background: #0b1f3a;
            color: #ffffff;
            border-color: #0b1f3a;
            transform: translateY(-1px);
        }

    .btn-table-purge {
        background: rgba(220, 38, 38, 0.04);
        border: 1px solid #fee2e2;
        color: #dc2626;
        font-weight: 600;
        font-size: 0.8rem;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        transition: all 0.2s ease;
    }

        .btn-table-purge:hover {
            background: #dc2626;
            color: #ffffff;
            border-color: #dc2626;
        }
</style>

<!-- SECTION DIRECTORY HEADER -->
<div class="d-flex align-items-center justify-content-between mb-3.5 pt-2">
    <div>
        <h4 class="fw-extrabold mb-1" style="color: #0b1f3a; tracking-tight: -0.02em;">Account Registries</h4>
        <p class="text-muted small mb-0">System level accounts authorized across the regional architecture node.</p>
    </div>
    <span class="badge bg-light text-dark border px-2.5 py-1.5 rounded-3 fw-semibold shadow-xs" style="font-size: 0.8rem;">
        Total Matrix Population: @Model.Count
    </span>
</div>

<!-- PREMIUM TABLE INTERFACE FRAME -->
<div class="premium-table-wrapper">
    <div class="table-responsive">
        <table class="table modern-dir-table">
            <thead>
                <tr>
                    <th style="width: 45%;">Security Account Identity</th>
                    <th style="width: 35%;">System Core Email</th>
                    <th class="text-end" style="width: 20%;">Node Interlocks</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var user in Model)
                    {
                        <tr>
                            <!-- IDENTITY HEADER -->
                            <td class="user-identity-cell">
                                @if (!string.IsNullOrWhiteSpace(user.FullName))
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center text-secondary font-monospace" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                            @user.FullName.Substring(0, Math.Min(2, user.FullName.Length)).ToUpper()
                                        </div>
                                        <span>@user.FullName</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted fw-normal fst-italic">No Profile Label Registered</span>
                                }
                            </td>

                            <!-- INTERFACE SYSTEM MAIL -->
                            <td class="user-comms-cell">
                                <span class="d-inline-flex align-items-center gap-1.5">
                                    <i class="bi bi-envelope text-slate-muted" style="font-size: 0.85rem;"></i>
                                    @user.Email
                                </span>
                            </td>

                            <!-- ACTION ELEMENT CLUSTERS -->
                            <td>
                                <div class="d-flex align-items-center justify-content-end gap-2">
                                    <a class="btn btn-sm btn-table-manage d-inline-flex align-items-center gap-1"
                                       href="/Admin/Users/Details/@user.Id">
                                        <i class="bi bi-sliders"></i> Adjust
                                    </a>

                                    <form method="post" action="/Admin/Users/Delete" class="m-0 p-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-table-purge d-inline-flex align-items-center gap-1"
                                                onclick="return confirm('Permanently wipe account matrix permissions for @(user.Email)? This operation is immutable.');">
                                            <i class="bi bi-trash3"></i> Purge
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-5 text-muted">
                            <i class="bi bi-people d-block fs-2 mb-2 text-slate-muted" style="opacity: 0.4;"></i>
                            <span class="small d-block">No system consumer accounts discovered in current cluster loop index.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>