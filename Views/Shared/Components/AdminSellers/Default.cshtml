@model List<ApplicationUser>

<div class="card border-0 rounded-4 overflow-hidden bg-white shadow-sm mt-2">
    <!-- MASTER CATALOG COMPONENT HEADER -->
    <div class="p-4 bg-white border-bottom border-light-subtle d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
        <div>
            <h5 class="fw-extrabold mb-1 tracking-tight" style="color: #0b1f3a; font-size: 1.15rem;">Verified Platform Merchants</h5>
            <p class="text-muted small mb-0">Monitor core merchant accounts, profile credentials, and digital communication endpoints.</p>
        </div>
        <span class="badge bg-light text-dark border border-light-subtle px-3 py-2 rounded-2 fw-bold fs-7.5 align-self-start align-self-sm-center shadow-sm">
            Total Merchant Profiles: @Model?.Count
        </span>
    </div>

    <!-- HIGH-FIDELITY MERCHANT REGISTRY DATA TABLE -->
    <div class="table-responsive">
        <table class="table align-middle custom-dashboard-table mb-0">
            <thead>
                <tr>
                    <th scope="col" class="text-uppercase tracking-wider fw-bold text-secondary ps-4 py-3" style="font-size: 0.725rem;">Merchant Name & Identity</th>
                    <th scope="col" class="text-uppercase tracking-wider fw-bold text-secondary py-3" style="font-size: 0.725rem;">Communication Endpoint</th>
                    <th scope="col" class="text-uppercase tracking-wider fw-bold text-secondary py-3" style="font-size: 0.725rem;">Security Verification</th>
                    <th scope="col" class="text-uppercase tracking-wider fw-bold text-secondary pe-4 py-3 text-end" style="font-size: 0.725rem;">Account Authorization</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            <div class="py-4">
                                <i class="bi bi-people display-5 text-black-50 mb-3 d-block"></i>
                                <span class="fw-semibold">No digital merchant or platform application accounts identified in context pools.</span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var user in Model)
                    {
                        <tr class="transition-all hover-row-state">
                            <!-- User Identity Profile Cluster -->
                            <td class="ps-4 py-3.5">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-placeholder rounded-circle d-flex align-items-center justify-content-center fw-bold text-info shadow-sm bg-info-subtle">
                                        @(!string.IsNullOrEmpty(user.FullName) ? user.FullName.Substring(0, 1).ToUpper() : "M")
                                    </div>
                                    <div>
                                        <span class="fw-bold d-block text-dark tracking-tight fs-6.5">@user.FullName</span>
                                        <span class="text-muted d-block" style="font-size: 0.75rem;">Account Node: Identity-Bound</span>
                                    </div>
                                </div>
                            </td>

                            <!-- Digital Identity Communication Node -->
                            <td class="py-3.5">
                                <span class="text-dark fw-semibold small d-flex align-items-center gap-1.5">
                                    <i class="bi bi-envelope-at text-muted" style="font-size: 0.85rem;"></i> @user.Email
                                </span>
                            </td>

                            <!-- Dynamic Security Badging Infrastructure -->
                            <td class="py-3.5">
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-2 fw-semibold d-inline-flex align-items-center gap-1">
                                    <span class="status-dot bg-success"></span> Profile Verified
                                </span>
                            </td>

                            <!-- Account Operational Status Controls -->
                            <td class="pe-4 py-3.5 text-end">
                                <span class="badge bg-light text-secondary border border-light-subtle px-2.5 py-1.5 rounded-2 fw-medium fs-7.5">
                                    <i class="bi bi-shield-shaded me-1"></i> Active System User
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    /* COMPONENT-LEVEL SCOPED STYLE ARCHITECTURES */
    .custom-dashboard-table thead {
        background-color: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

    .custom-dashboard-table th {
        font-weight: 700 !important;
        background: #f8fafc !important;
    }

    .custom-dashboard-table tbody tr {
        border-bottom: 1px solid #f1f5f9;
    }

        .custom-dashboard-table tbody tr:last-child {
            border-bottom: none;
        }

    /* CUSTOM INTERNAL HOVER RESPONSE ENGINE */
    .hover-row-state {
        background-color: #ffffff;
    }

        .hover-row-state:hover {
            background-color: #f8fafc !important;
        }

    /* IDENTITY EMBLEM DECORATORS */
    .avatar-placeholder {
        width: 36px;
        height: 36px;
        font-size: 0.875rem;
        letter-spacing: -0.02em;
    }

    /* TEXT GEOMETRIES SHIMS */
    .fs-6.5 {
        font-size: 0.925rem;
    }

    .fs-7.5 {
        font-size: 0.8rem;
    }

    .py-3.5 {
        padding-top: 0.875rem;
        padding-bottom: 0.875rem;
    }

    .gap-1.5 {
        gap: 0.375rem;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        display: inline-block;
    }

    /* TRANSITION SMOOTHING MATRIX */
    .transition-all {
        transition: all 0.2s ease-in-out !important;
    }
</style>