@model AdminKpiViewModel

<style>
    .kpi-card-wrapper {
        background: #ffffff;
        border: 1px solid #e2e8f0 !important;
        border-radius: 16px !important;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

        .kpi-card-wrapper:hover {
            transform: translateY(-3px);
            border-color: rgba(11, 31, 58, 0.12) !important;
            box-shadow: 0 10px 25px -5px rgba(11, 31, 58, 0.05), 0 8px 16px -6px rgba(11, 31, 58, 0.03) !important;
        }

    .kpi-icon-square {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.25rem;
        transition: all 0.25s ease;
    }

    .kpi-card-wrapper:hover .kpi-icon-square {
        transform: scale(1.05) rotate(3deg);
    }

    .kpi-meta-title {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: #64748b;
    }

    .kpi-metric-display {
        color: #0b1f3a;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.1;
    }

    .micro-trend-badge {
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
    }
</style>

<div class="row g-3 mb-4">

    <!-- TOTAL LEADS KPI CARD -->
    <div class="col-6 col-xl-3">
        <div class="card p-4 shadow-sm h-100 kpi-card-wrapper">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="text-uppercase kpi-meta-title">Pipeline Leads</span>
                <div class="kpi-icon-square bg-primary-subtle text-primary border border-primary-subtle">
                    <i class="bi bi-funnel-fill"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline gap-2 flex-wrap">
                <h2 class="h1 mb-0 kpi-metric-display">@Model.TotalLeads</h2>
                <span class="micro-trend-badge bg-success-subtle text-success">
                    <i class="bi bi-graph-up-arrow me-0.5"></i> Active
                </span>
            </div>
        </div>
    </div>

    <!-- ACTIVE PRODUCTS KPI CARD -->
    <div class="col-6 col-xl-3">
        <div class="card p-4 shadow-sm h-100 kpi-card-wrapper">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="text-uppercase kpi-meta-title">Master Catalog</span>
                <div class="kpi-icon-square bg-warning-subtle text-warning border border-warning-subtle" style="color: #b45309 !important;">
                    <i class="bi bi-box-seam-fill"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline gap-2 flex-wrap">
                <h2 class="h1 mb-0 kpi-metric-display">@Model.ActiveProducts</h2>
                <span class="text-muted small fw-medium" style="font-size: 0.75rem;">Skus Live</span>
            </div>
        </div>
    </div>

    <!-- VERIFIED SELLERS KPI CARD -->
    <div class="col-6 col-xl-3">
        <div class="card p-4 shadow-sm h-100 kpi-card-wrapper">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="text-uppercase kpi-meta-title">Verified Sellers</span>
                <div class="kpi-icon-square bg-info-subtle text-info border border-info-subtle">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline gap-2 flex-wrap">
                <h2 class="h1 mb-0 kpi-metric-display">@Model.VerifiedSellers</h2>
                <span class="micro-trend-badge bg-info-subtle text-info-emphasis fw-semibold">
                    <i class="bi bi-shield-check"></i> Monitored
                </span>
            </div>
        </div>
    </div>

    <!-- NETWORK THROUGHPUT KPI CARD -->
    <div class="col-6 col-xl-3">
        <div class="card p-4 shadow-sm h-100 kpi-card-wrapper">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="text-uppercase kpi-meta-title">Network Bus</span>
                <div class="kpi-icon-square bg-success-subtle text-success border border-success-subtle">
                    <i class="bi bi-cpu-fill"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline gap-2 flex-wrap">
                <h2 class="h1 mb-0 kpi-metric-display">@Model.NetworkThroughput</h2>
                <span class="text-success small fw-bold d-flex align-items-center gap-1" style="font-size: 0.75rem;">
                    <span class="d-inline-block bg-success rounded-circle" style="width:6px; height:6px;"></span> 100% Operational
                </span>
            </div>
        </div>
    </div>

</div>