@model List<YellowphaseWebsite.Models.ContactLead>

<div class="card border-0 rounded-4 overflow-hidden bg-white shadow-sm mt-2">
    <div class="p-4 bg-white border-bottom border-light-subtle d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-extrabold mb-1 tracking-tight" style="color: #0b1f3a; font-size: 1.15rem;">Recent Platform Inbound Enquiries</h5>
            <p class="text-muted small mb-0">Review real-time client routing pipelines, target interests, and contact coordinates.</p>
        </div>
        <span class="badge bg-light text-dark border border-light-subtle px-3 py-2 rounded-2 fw-bold fs-7.5 shadow-sm">
            Total Record Count: @Model?.Count
        </span>
    </div>

    <div class="table-responsive">
        <table class="table align-middle custom-dashboard-table mb-0">
            <thead>
                <tr>
                    <th scope="col" class="text-uppercase tracking-wider fw-bold text-secondary ps-4 py-3" style="font-size: 0.725rem;">Sender Profile</th>
                    <th scope="col" class="text-uppercase tracking-wider fw-bold text-secondary py-3" style="font-size: 0.725rem;">Contact Endpoint</th>
                    <th scope="col" class="text-uppercase tracking-wider fw-bold text-secondary py-3" style="font-size: 0.725rem;">Requested Service</th>
                    <th scope="col" class="text-uppercase tracking-wider fw-bold text-secondary py-3" style="font-size: 0.725rem;">Transmission Brief</th>
                    <th scope="col" class="text-uppercase tracking-wider fw-bold text-secondary pe-4 py-3 text-end" style="font-size: 0.725rem;">Timestamp</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <div class="py-4">
                                <i class="bi bi-inbox-fill display-5 text-black-50 mb-3 d-block"></i>
                                <span class="fw-semibold">No active data leads identified in pipeline data architecture pools.</span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var lead in Model)
                    {
                        <tr class="transition-all hover-row-state">
                            <td class="ps-4 py-3.5">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-placeholder rounded-circle d-flex align-items-center justify-content-center fw-bold text-primary shadow-sm bg-primary-subtle">
                                        @(!string.IsNullOrEmpty(lead.Name) ? lead.Name.Substring(0, 1).ToUpper() : "U")
                                    </div>
                                    <div>
                                        <span class="fw-bold d-block text-dark tracking-tight fs-6.5">@lead.Name</span>
                                        <span class="text-muted d-block" style="font-size: 0.75rem;">ID Key: #@lead.Id</span>
                                    </div>
                                </div>
                            </td>

                            <td class="py-3.5">
                                <div class="d-flex flex-column">
                                    <span class="text-dark fw-semibold small d-flex align-items-center gap-1.5 mb-0.5">
                                        <i class="bi bi-envelope text-muted" style="font-size: 0.85rem;"></i> @lead.Email
                                    </span>
                                    <span class="text-muted d-flex align-items-center gap-1.5" style="font-size: 0.775rem;">
                                        <i class="bi bi-telephone" style="font-size: 0.8rem;"></i> @lead.Phone
                                    </span>
                                </div>
                            </td>

                            <td class="py-3.5">
                                @if (lead.Service?.ToLower().Contains("dev") == true || lead.Service?.ToLower().Contains("tech") == true)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1.5 rounded-2 fw-semibold">
                                        <i class="bi bi-code-square me-1"></i> @lead.Service
                                    </span>
                                }
                                else if (lead.Service?.ToLower().Contains("merchant") == true || lead.Service?.ToLower().Contains("sale") == true)
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1.5 rounded-2 fw-semibold" style="color: #b27f00 !important; border-color: #ffe099 !important; background-color: #fffbeb !important;">
                                        <i class="bi bi-shop me-1"></i> @lead.Service
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1.5 rounded-2 fw-semibold">
                                        <i class="bi bi-layers me-1"></i> @(lead.Service ?? "General Intent")
                                    </span>
                                }
                            </td>

                            <td class="py-3.5 max-width-message">
                                <span class="text-dark small tracking-tight block-text-truncate" title="@lead.Message">
                                    @(lead.Message?.Length > 55 ? lead.Message.Substring(0, 52) + "..." : lead.Message ?? "Empty data payload packet.")
                                </span>
                            </td>

                            <td class="pe-4 py-3.5 text-end">
                                <span class="fw-semibold text-muted small"><i class="bi bi-calendar3 text-body-tertiary me-1"></i> @lead.CreatedAt.ToString("yyyy-MM-dd")</span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    /* COMPONENT-LEVEL SCOPED STYLE ARCHITECTURES */
    .custom-dashboard-table thead {
        background-color: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

    .custom-dashboard-table th {
        font-weight: 700 !important;
        background: #f8fafc !important;
    }

    .custom-dashboard-table tbody tr {
        border-bottom: 1px solid #f1f5f9;
    }

        .custom-dashboard-table tbody tr:last-child {
            border-bottom: none;
        }

    /* CUSTOM INTERNAL HOVER RESPONSE ENGINE */
    .hover-row-state {
        background-color: #ffffff;
    }

        .hover-row-state:hover {
            background-color: #f8fafc !important;
        }

    /* TYPOGRAPHY INJECTION SHIMS */
    .fs-6.5 {
        font-size: 0.925rem;
    }

    .fs-7.5 {
        font-size: 0.8rem;
    }

    .py-3.5 {
        padding-top: 0.875rem;
        padding-bottom: 0.875rem;
    }

    .gap-1.5 {
        gap: 0.375rem;
    }

    /* CORE IDENTITY VISUALS WRAPPER */
    .avatar-placeholder {
        width: 36px;
        height: 36px;
        font-size: 0.875rem;
        letter-spacing: -0.02em;
    }

    /* RESPONSIVE LAYOUT CONSTRAINTS FOR DATA FLOW BLOCKS */
    .max-width-message {
        max-width: 280px;
    }

    .block-text-truncate {
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>