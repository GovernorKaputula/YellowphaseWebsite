@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - YellowPhase Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <style>
            :root {
                --primary: #0b1f3a;
                --accent: #f4c542;
                --bg-canvas: #f8fafc;
                --slate-muted: #64748b;
                --slate-dark: #334155;
                --border-color: rgba(241, 245, 249, 0.9);
                --card-shadow: 0 4px 20px -2px rgba(11, 31, 58, 0.04), 0 2px 6px -1px rgba(11, 31, 58, 0.02);
                --transition-smooth: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            }

            body {
                background-color: var(--bg-canvas);
                font-family: 'Inter', system-ui, -apple-system, sans-serif;
                color: var(--slate-dark);
                -webkit-font-smoothing: antialiased;
            }

            /* --- MODERN NAVBAR COMPONENT --- */
            .modern-navbar {
                background: rgba(255, 255, 255, 0.95) !important;
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border-bottom: 1px solid var(--border-color);
                padding: 0.75rem 0;
                box-shadow: 0 1px 3px rgba(11, 31, 58, 0.02);
            }

            .custom-nav-link {
                color: #475569 !important;
                font-size: 0.92rem;
                font-weight: 500;
                padding: 0.5rem 0.75rem !important;
                border-radius: 8px;
                transition: var(--transition-smooth);
            }

                .custom-nav-link:hover {
                    color: var(--primary) !important;
                    background-color: #f1f5f9;
                }

            .seller-link {
                border: 1px solid var(--accent);
                background-color: rgba(244, 197, 66, 0.08);
                color: var(--primary) !important;
            }

                .seller-link:hover {
                    background-color: var(--accent) !important;
                    color: #000 !important;
                    transform: translateY(-1px);
                }

            .quote-btn {
                background: var(--primary);
                border-radius: 8px;
                font-size: 0.9rem;
                transition: var(--transition-smooth);
            }

                .quote-btn:hover {
                    background: #061324 !important;
                    transform: translateY(-1px);
                    box-shadow: 0 6px 16px rgba(11, 31, 58, 0.18);
                }

            /* --- USER IDENTITY NAVIGATION DECK --- */
            .user-profile-dropdown .dropdown-toggle::after {
                display: none;
            }

            .user-profile-dropdown .dropdown-menu {
                border: 1px solid rgba(15, 23, 42, 0.08);
                box-shadow: 0 10px 30px rgba(11, 31, 58, 0.1);
                border-radius: 12px;
                padding: 0.5rem;
                min-width: 240px;
            }

            .user-profile-dropdown .dropdown-item {
                border-radius: 8px;
                padding: 0.6rem 1rem;
                font-size: 0.88rem;
                color: var(--slate-dark);
                font-weight: 500;
                transition: var(--transition-smooth);
            }

                .user-profile-dropdown .dropdown-item:hover {
                    background-color: #f1f5f9;
                    color: var(--primary);
                }

                .user-profile-dropdown .dropdown-item.logout-trigger:hover {
                    background-color: #fef2f2;
                    color: #dc2626;
                }

            /* --- DASHBOARD CONTROL SYSTEM --- */
            .fw-extrabold {
                font-weight: 800;
            }

            .leading-tight {
                line-height: 1.2;
            }

            .tracking-tight {
                letter-spacing: -0.02em;
            }

            .shadow-xs {
                box-shadow: 0 1px 2px rgba(0,0,0,0.02);
            }

            /* Premium Workspace Tabs Architecture */
            .dashboard-pills {
                background-color: #f1f5f9 !important;
                padding: 0.35rem !important;
                border-radius: 12px !important;
                border: 1px solid rgba(226, 232, 240, 0.8) !important;
            }

                .dashboard-pills .nav-link {
                    color: var(--slate-muted) !important;
                    border-radius: 9px !important;
                    font-weight: 600;
                    font-size: 0.88rem;
                    padding: 0.6rem 1.2rem !important;
                    transition: var(--transition-smooth) !important;
                    border: 1px solid transparent !important;
                }

                    .dashboard-pills .nav-link:hover {
                        color: var(--primary) !important;
                        background-color: rgba(255, 255, 255, 0.5);
                    }

                    .dashboard-pills .nav-link.active {
                        background: #ffffff !important;
                        color: var(--primary) !important;
                        border-color: rgba(226, 232, 240, 0.5) !important;
                        box-shadow: 0 4px 10px rgba(11, 31, 58, 0.05) !important;
                    }

                    .dashboard-pills .nav-link i {
                        font-size: 1.05rem;
                        transition: transform 0.2s ease;
                    }

                    .dashboard-pills .nav-link:hover i {
                        transform: scale(1.1);
                    }

            /* Interactive Dashboard Component Cards */
            .setting-interactive-card {
                background: #ffffff;
                border: 1px solid #e2e8f0 !important;
                transition: var(--transition-smooth);
            }

                .setting-interactive-card:hover {
                    transform: translateY(-3px);
                    border-color: rgba(11, 31, 58, 0.12) !important;
                    box-shadow: 0 10px 25px -5px rgba(11, 31, 58, 0.05), 0 8px 16px -6px rgba(11, 31, 58, 0.03);
                }

                .setting-interactive-card .icon-box {
                    transition: var(--transition-smooth);
                }

                .setting-interactive-card:hover .icon-box {
                    transform: scale(1.05);
                    background-color: var(--primary) !important;
                    color: #ffffff !important;
                }

                    .setting-interactive-card:hover .icon-box.text-warning {
                        background-color: var(--accent) !important;
                        color: #000000 !important;
                    }

            /* --- HARDWARE ECOSYSTEM ANIMATION ENGINE --- */
            .pulse-indicator {
                width: 8px;
                height: 8px;
                background: #10b981;
                border-radius: 50%;
                display: inline-block;
                margin-right: 8px;
                position: relative;
            }

                .pulse-indicator::after {
                    content: '';
                    width: 100%;
                    height: 100%;
                    background: #10b981;
                    border-radius: 50%;
                    position: absolute;
                    top: 0;
                    left: 0;
                    animation: ecopulse 2s infinite ease-out;
                }

            @@keyframes ecopulse {
                0% {
                    transform: scale(1);
                    opacity: 0.75;
                }

                100% {
                    transform: scale(2.5);
                    opacity: 0;
                }
            }

            /* --- RESPONSIVE STRUCTURAL OVERRIDES --- */
            @@media (max-width: 991.98px) {
                .navbar-nav {
                    align-items: stretch !important;
                }

                .custom-nav-link {
                    width: 100%;
                    padding: 0.65rem 1rem !important;
                }

                .seller-link {
                    border: none;
                    background: transparent;
                }

                    .seller-link:hover {
                        background-color: #f1f5f9 !important;
                    }

                .dashboard-pills {
                    display: flex;
                    width: 100%;
                    overflow-x: auto;
                    white-space: nowrap;
                    flex-wrap: nowrap;
                }

                    .dashboard-pills .nav-item {
                        flex: 0 0 auto;
                    }

                .user-profile-dropdown .dropdown-menu {
                    position: static !important;
                    float: none;
                    width: 100%;
                    box-shadow: none;
                    border: 1px solid var(--border-color);
                    margin-top: 0.5rem;
                }
            }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg sticky-top modern-navbar">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="/images/logo.png" alt="Logo" class="navbar-logo-img" style="height: 46px; transition: transform 0.2s ease;">
                <div class="d-flex flex-column ms-2 leading-tight">
                    <span class="fw-bold tracking-tight fs-3" style="color: var(--accent);">Yellow<span style="color: var(--primary);">Phase</span></span>
                    <span class="text-muted d-none d-sm-inline" style="font-size: 0.7rem; font-weight: 500; letter-spacing: 0.02em;">Providing WorldClass Solutions</span>
                </div>
            </a>

            <button class="navbar-toggler border-0 p-2 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto align-items-center gap-1 gap-lg-2 pt-3 pt-lg-0">
                    <li class="nav-item"><a class="nav-link custom-nav-link" href="/"><i class="bi bi-house-door me-1"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link custom-nav-link" href="/Home/About"><i class="bi bi-info-circle me-1"></i> About</a></li>
                    <li class="nav-item"><a class="nav-link custom-nav-link" href="/Home/Services"><i class="bi bi-gear-wide-connected me-1"></i> Services</a></li>
                    <li class="nav-item"><a class="nav-link custom-nav-link" href="/Home/Projects"><i class="bi bi-kanban me-1"></i> Projects</a></li>

                    <li class="nav-item">
                        <a class="nav-link custom-nav-link d-flex align-items-center gap-1" href="/Home/Solutions">
                            <i class="bi bi-cpu text-primary"></i> Digital Solutions
                            <span class="badge rounded-pill bg-light border small text-dark shadow-xs">Store</span>
                        </a>
                    </li>

                    <li class="nav-item"><a class="nav-link custom-nav-link" href="/Products"><i class="bi bi-gpu-card me-1"></i> Store</a></li>

                 

                    <!-- =========================================================
                        INJECTED AUTHENTICATION DECK NODES
                    ========================================================= -->
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item dropdown user-profile-dropdown ms-lg-2 w-100 w-lg-auto mt-2 mt-lg-0">
                            <button class="btn btn-light border dropdown-toggle d-flex align-items-center justify-content-between justify-content-lg-start gap-2 w-100 rounded-pill px-3 py-1.5 shadow-sm"
                                    id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false" style="transition: var(--transition-smooth);">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white shadow-xs"
                                         style="width:26px; height:26px; background-color: var(--primary); font-size: 0.75rem;">
                                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <span class="fw-semibold text-dark text-truncate" style="font-size: 0.85rem; max-width: 110px;">
                                        Hello, @(User.Identity.Name?.Split('@')[0] ?? "Operator")
                                    </span>
                                </div>
                                <i class="bi bi-chevron-down text-muted ms-1 small"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuButton">
                                <div class="px-3 py-2 border-bottom mb-1">
                                    <span class="d-block small text-muted">Signed in as</span>
                                    <span class="d-block fw-bold text-dark font-monospace text-truncate small">@User.Identity.Name</span>
                                </div>
                                <li><a class="dropdown-item" href="/Manage/Account"><i class="bi bi-person me-2"></i> Profile Settings</a></li>
                                <li><a class="dropdown-item" href="/Manage/Security"><i class="bi bi-shield-check me-2"></i> Access Logs</a></li>
                                <li><hr class="dropdown-divider opacity-50"></li>
                                <li>
                                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" id="logoutFormWrapper">
                                        <button type="submit" class="dropdown-item logout-trigger w-100 text-start border-0 bg-transparent">
                                            <i class="bi bi-box-arrow-right me-2"></i> Terminate Session
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item ms-lg-2 mt-2 mt-lg-0 w-100 w-lg-auto">
                            <a class="btn text-white px-4 py-2 fw-semibold w-100 quote-btn" href="/Home/Contact">
                                Get Quote <i class="bi bi-arrow-right-short ms-1"></i>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container py-4 min-vh-100">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <span class="text-uppercase fw-bold text-secondary d-block mb-1" style="font-size:0.72rem; letter-spacing:0.08em;">
                    Enterprise Controller Node
                </span>
                <h1 class="h2 fw-extrabold mb-0" style="color: var(--primary);">
                    Admin Command Center
                </h1>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-secondary bg-white shadow-sm px-3 py-2 rounded-3 text-dark fw-medium" onclick="window.location.reload();" style="transition: var(--transition-smooth);">
                    <i class="bi bi-arrow-clockwise me-1"></i> Synchronize Node
                </button>
                <div class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-3 d-inline-flex align-items-center fw-semibold">
                    <span class="pulse-indicator"></span>
                    Live Ecosystem Sync
                </div>
            </div>
        </div>

        @await Component.InvokeAsync("AdminKpi")

        <!-- PREMIUM HIGH-PERFORMANCE WORKSPACE SEGMENTATION -->
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4" style="box-shadow: var(--card-shadow) !important;">

            <!-- MODERN NAVIGATION PILLS AND WRAPPERS -->
            <div class="border-bottom border-light-subtle pb-3 mb-4">
                <ul class="nav dashboard-pills gap-1" id="adminTabs" role="tablist" style="list-style: none;">
                    <li role="presentation" class="m-0 p-0">
                        <button class="nav-link active d-flex align-items-center gap-2 border-0 px-4 py-2.5 fw-semibold"
                                id="leads-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#leads"
                                type="button"
                                role="tab">
                            <i class="bi bi-funnel-fill"></i> Inbound Leads
                        </button>
                    </li>
                    <li role="presentation" class="m-0 p-0">
                        <button class="nav-link d-flex align-items-center gap-2 border-0 px-4 py-2.5 fw-semibold"
                                id="products-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#products"
                                type="button"
                                role="tab">
                            <i class="bi bi-box-seam-fill"></i> Master Products
                        </button>
                    </li>
                    <li role="presentation" class="m-0 p-0">
                        <button class="nav-link d-flex align-items-center gap-2 border-0 px-4 py-2.5 fw-semibold"
                                id="sellers-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#sellers"
                                type="button"
                                role="tab">
                            <i class="bi bi-person-lines-fill"></i> Distribution Network
                        </button>
                    </li>
                    <li role="presentation" class="m-0 p-0">
                        <button class="nav-link d-flex align-items-center gap-2 border-0 px-4 py-2.5 fw-semibold"
                                id="settings-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#settings"
                                type="button"
                                role="tab">
                            <i class="bi bi-sliders2"></i> Global Parameters
                        </button>
                    </li>
                    <li role="presentation" class="m-0 p-0">
                        <button class="nav-link d-flex align-items-center gap-2 border-0 px-4 py-2.5 fw-semibold"
                                id="users-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#users"
                                type="button"
                                role="tab">
                            <i class="bi bi-people-fill"></i> Users
                        </button>
                    </li>
                </ul>
            </div>

            <!-- STYLIZED INTERACTIVE CONTENT FRAMES -->
            <div class="tab-content dashboard-viewport mt-2" id="adminTabsContent">

                <!-- ================= LEADS TAB ENGINE ================= -->
                <div class="tab-pane fade show active" id="leads" role="tabpanel" aria-labelledby="leads-tab">
                    <div class="table-responsive-container">
                        @await Html.PartialAsync("_LeadsTable", Model as List<YellowphaseWebsite.Models.ContactLead>)
                    </div>
                </div>

                <!-- ================= PRODUCTS TAB ENGINE ================= -->
                <div class="tab-pane fade" id="products" role="tabpanel" aria-labelledby="products-tab">
                    <div class="component-view-frame">
                        @await Component.InvokeAsync("AdminProducts")
                    </div>
                </div>

                <!-- ================= SELLERS TAB ENGINE ================= -->
                <div class="tab-pane fade" id="sellers" role="tabpanel" aria-labelledby="sellers-tab">
                    <div class="component-view-frame">
                        @await Component.InvokeAsync("AdminSellers")
                    </div>
                </div>

                <!-- ================= USERS TAB ENGINE ================= -->
                <div class="tab-pane fade" id="users" role="tabpanel" aria-labelledby="users-tab">
                    <div class="component-view-frame">
                        @await Component.InvokeAsync("AdminUsers")
                    </div>
                </div>

                <!-- ================= SETTINGS TAB ENGINE ================= -->
                <div class="tab-pane fade" id="settings" role="tabpanel" aria-labelledby="settings-tab">
                    <div class="row g-4 py-2">

                        <!-- ROLE MANAGEMENT -->
                        <div class="col-12 col-md-6">
                            <div class="p-4 rounded-4 h-100 setting-interactive-card">
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="p-2.5 rounded-3 bg-light text-primary border shadow-sm icon-box d-flex align-items-center justify-content-center" style="width:42px; height:42px;">
                                        <i class="bi bi-shield-lock-fill fs-5"></i>
                                    </div>
                                    <h5 class="fw-bold mb-0" style="color: var(--primary);">User Role Management</h5>
                                </div>

                                <p class="text-muted small mb-4 lh-lg">
                                    Manage system access levels, assign structural accounts (Admin, Merchant, Developer), and orchestrate real-time permissions across the marketplace network.
                                </p>

                                <a href="#"
                                   onclick="showUsersTab(); return false;"
                                   class="text-decoration-none small fw-bold d-inline-flex align-items-center gap-1 text-primary">
                                    Open User Control System <i class="bi bi-arrow-right-short fs-5"></i>
                                </a>
                            </div>
                        </div>

                        <!-- SYSTEM CONFIG -->
                        <div class="col-12 col-md-6">
                            <div class="p-4 rounded-4 h-100 setting-interactive-card">
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="p-2.5 rounded-3 bg-light text-warning border shadow-sm icon-box d-flex align-items-center justify-content-center" style="width:42px; height:42px;">
                                        <i class="bi bi-gear-wide-connected fs-5"></i>
                                    </div>
                                    <h5 class="fw-bold mb-0" style="color: var(--primary);">System Configuration</h5>
                                </div>

                                <p class="text-muted small mb-4 lh-lg">
                                    Control deployment metadata, adjust environment hooks, toggle API secure routing configurations, and manage backend engine policies.
                                </p>

                                <a href="javascript:void(0);"
                                   class="text-decoration-none small fw-bold d-inline-flex align-items-center gap-1 text-primary">
                                    Configure Engine Values <i class="bi bi-arrow-right-short fs-5"></i>
                                </a>
                            </div>
                        </div>

                        <!-- SECURITY ALERT PANEL -->
                        <div class="col-12">
                            <div class="alert bg-light border-0 p-4 rounded-4 d-flex align-items-start gap-3 mb-0" style="background-color: rgba(241, 245, 249, 0.6) !important; border: 1px dashed #cbd5e1 !important;">
                                <i class="bi bi-shield-fill-check text-success fs-4"></i>
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">Administrative Control Layer Auditing Active</h6>
                                    <span class="text-muted small d-block lh-base">
                                        Every modification executed within this node environment is explicitly tracked and signed cryptographically within security ledger logs. Modifying parameters could influence running consumer store modules natively.
                                    </span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

        <!-- LOWER INJECTED CONTENT SLOT -->
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4" style="box-shadow: var(--card-shadow) !important;">
            @RenderBody()
        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>