    <style>
            /* FIXED POSITION BLOCK: Keeps the entire nav setup clean at the top of the viewport */
            .header-sticky-group {
                position: sticky;
                top: 0;
                width: 100%;
                z-index: 1050;
                box-shadow: 0 4px 20px rgba(11, 31, 58, 0.05);
            }

            /* UPDATED: Solid modern clean background instead of a transparent overlay */
            .modern-navbar {
                background: #ffffff !important;
                border-bottom: 1px solid rgba(241, 245, 249, 0.9);
                padding-top: 0.75rem;
                padding-bottom: 0.75rem;
                font-family: 'Inter', system-ui, -apple-system, sans-serif;
            }

            /* UPDATED: Darker off-slate text color for high contrast against the solid white background */
            .custom-nav-link {
                color: #475569 !important;
                font-size: 0.92rem;
                font-weight: 500;
                padding: 0.5rem 0.75rem !important;
                border-radius: 6px;
                transition: all 0.15s ease;
            }

                .custom-nav-link:hover {
                    color: #0b1f3a !important;
                    background-color: #f8fafc;
                }

            /* Seller Link using custom solar yellow highlights */
            .seller-link {
                border: 1px solid #f4c542;
                background-color: rgba(244, 197, 66, 0.1);
                color: #0b1f3a !important;
            }

                .seller-link:hover {
                    background-color: #f4c542 !important;
                    border-color: #f4c542;
                    color: #0b1f3a !important;
                }

            /* Primary engineering blue highlight button */
            .quote-btn:hover {
                background: #061324 !important;
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(11, 31, 58, 0.15);
            }

            .navbar-brand:hover .navbar-logo-img {
                transform: scale(1.03);
            }

            .leading-tight {
                line-height: 1.2;
            }

            .tracking-tight {
                letter-spacing: -0.02em;
            }

            .shadow-xs {
                box-shadow: 0 1px 2px rgba(0,0,0,0.02);
            }

            .py-1.5 {
                padding-top: 0.375rem;
                padding-bottom: 0.375rem;
            }

            @@media (max-width: 991.98px) {
                .navbar-nav {
                    align-items: flex-start !important;
                    background: #ffffff;
                    padding: 1rem 0 !important;
                    margin-top: 0.5rem;
                }

                .custom-nav-link {
                    width: 100%;
                    padding: 0.65rem 1rem !important;
                }

                .seller-link {
                    border-radius: 6px !important;
                    border: none;
                    padding: 0.65rem 1rem !important;
                    color: #0b1f3a !important;
                    background: transparent;
                }

                    .seller-link:hover {
                        background-color: #f8fafc !important;
                    }
            }
    </style>

    <style>
            :root {
                --primary: #0b1f3a;
                --accent: #f4c542;
            }

            body {
                font-family: 'Inter', sans-serif;
                color: #334155;
            }

            /* UPDATED: Solid high contrast Top Bar */
            .top-bar {
                background: #08172c;
                color: #ffffff;
                font-size: 0.85rem;
                padding: 8px 0;
            }

            /* NAVBAR BASE */
            .navbar {
                padding: 15px 0;
            }

            .navbar-brand {
                font-weight: 800;
                font-size: 1.5rem;
            }

            .nav-link {
                font-weight: 500;
                transition: 0.3s;
                padding: 0 15px !important;
            }

            /* FOOTER */
            footer {
                background: var(--primary);
                color: #cbd5e1;
                padding: 60px 0 30px;
                position: relative;
                z-index: 10;
            }

            .footer-title {
                color: var(--accent);
                font-weight: 700;
                margin-bottom: 20px;
            }

            /* UTILS */
            .btn-yellow {
                background: var(--accent);
                color: #000;
                font-weight: 700;
                border-radius: 50px;
                padding: 10px 25px;
            }

                .btn-yellow:hover {
                    background: #e0b935;
                }

            .card {
                border-radius: 12px;
            }

                .card:hover {
                    transform: translateY(-5px);
                    transition: 0.3s;
                }

            .section-light {
                background-color: #ffffff;
            }

            .section-grey {
                background-color: #f8f9fa;
            }

            .tagline {
                white-space: normal;
                word-break: break-word;
                font-size: 20px;
            }

            @@media (max-width: 768px) {
                .tagline {
                    font-size: 14px;
                }
            }
    </style>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body class="d-flex flex-column min-vh-100">

    <div class="header-sticky-group">
        <div class="top-bar d-none d-md-block">
            <div class="container d-flex justify-content-between">
                <div><i class="fa fa-envelope me-2"></i>info@yellowphase.org</div>
                <div><i class="fa fa-phone me-2"></i>+260 96 222 7741</div>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg modern-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" href="/">
                    <img src="/images/logo.png" alt="Logo" class="navbar-logo-img" style="height: 50px; transition: transform 0.2s ease;">
                    <div class="d-flex flex-column ms-2 leading-tight">
                        <span class="fw-bold tracking-tight fs-3" style="color: #f4c542;">Yellow<span style="color: #0b1f3a;">Phase</span></span>
                     
                    </div>
                </a>

                <button class="navbar-toggler border-0 p-2 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav ms-auto align-items-center gap-1 gap-lg-2 pt-3 pt-lg-0">
                        <li class="nav-item"><a class="nav-link custom-nav-link" href="/">Home</a></li>

                        <li class="nav-item">
                            <a class="nav-link custom-nav-link d-flex align-items-center gap-1" asp-controller="Home" asp-action="SolarPackages">
                                <i class="bi bi-sun" style="color: #f4c542;"></i> Solar Packages
                            </a>
                        </li>

                        <li class="nav-item"><a class="nav-link custom-nav-link" href="/Home/About">About</a></li>
                        <li class="nav-item"><a class="nav-link custom-nav-link" href="/Home/Services">Services</a></li>
                        <li class="nav-item"><a class="nav-link custom-nav-link" href="/Home/Projects">Projects</a></li>

                        <li class="nav-item">
                            <a class="nav-link custom-nav-link d-flex align-items-center gap-1 solutions-store-link" href="/Home/Solutions">
                                <i class="bi bi-cpu" style="color: #0b1f3a;"></i> Digital Solutions
                            </a>
                        </li>

                        <li class="nav-item"><a class="nav-link custom-nav-link" href="/Products">Store</a></li>

                        <li class="nav-item ms-lg-2">
                            <a class="nav-link custom-nav-link seller-link px-3 py-1.5 rounded-pill" href="/Account/Login" style="font-size: 0.85rem; font-weight: 600;">
                                <i class="bi bi-shop me-1"></i> I am A Seller
                            </a>
                        </li>

                        <li class="nav-item ms-lg-2 mt-2 mt-lg-0 w-100 w-lg-auto">
                            <a class="btn text-white px-4 py-2 fw-semibold w-100 quote-btn" href="/Home/Contact"
                               style="background: #0b1f3a; border-radius: 8px; font-size: 0.9rem; transition: all 0.2s ease;">
                                Get Quote <i class="bi bi-arrow-right-short ms-1"></i>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </div>

    <main class="flex-fill">
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <div class="row g-5">
                <div class="col-md-4">
                    <h5 class="footer-title">YellowPhase</h5>
                    <p>Engineering excellence across Zambia. Delivering sustainable solar, electrical, and ICT solutions for the modern era.</p>
                </div>
                <div class="col-md-4 text-md-center">
                    <h5 class="footer-title">Quick Links</h5>
                    <ul class="list-unstyled">
                        <li><a href="/Home/Services" class="text-white text-decoration-none">Our Services</a></li>
                        <li><a href="/Home/Projects" class="text-white text-decoration-none">Latest Projects</a></li>
                    </ul>
                </div>
                <div class="col-md-4 text-md-end">
                    <h5 class="footer-title">Contact Us</h5>
                    <p><i class="fa fa-phone me-2"></i>+260 96 222 7741</p>
                    <p><i class="fa fa-envelope me-2"></i>info@yellowphase.org</p>
                </div>
            </div>
            <hr class="mt-5 border-secondary">
            <div class="text-center pt-3">&copy; @DateTime.Now.Year YellowPhase. All Rights Reserved.</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>