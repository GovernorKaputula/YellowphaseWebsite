@model YellowphaseWebsite.ViewModels.ProductViewModel

<div class="product-details-canvas py-5 min-vh-100 text-dark" style="background-color: #ffffff; font-family: 'Inter', system-ui, -apple-system, sans-serif; position: relative; overflow: hidden;">

    <div class="position-absolute top-0 start-0 w-100 h-100"
         style="background-image: linear-gradient(rgba(0, 0, 0, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 0, 0, 0.03) 1px, transparent 1px); background-size: 40px 40px; pointer-events: none; opacity: 1;">
    </div>

    <div class="container position-relative z-index-1 py-4">

        <nav aria-label="breadcrumb" class="mb-5">
            <ol class="breadcrumb m-0 px-0 text-uppercase tracking-wider" style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em;">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Home</a></li>
                <li class="breadcrumb-item"><a href="/Products" class="text-decoration-none text-muted">Catalog</a></li>
                <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">@Model.Category</li>
            </ol>
        </nav>

        <div class="row g-5">

            <div class="col-xl-6 col-lg-6 col-12">
                <div class="sticky-top-gallery-wrapper" style="top: 2rem;">

                    <div id="productAssetCarousel" class="carousel slide main-preview-frame rounded-4 p-4 mb-3 position-relative" data-bs-ride="carousel"
                         style="background: #f9f9f9; border: 1px solid rgba(0, 0, 0, 0.06); height: 500px; box-shadow: 0 15px 35px rgba(0,0,0,0.05); overflow: hidden;">

                        <span class="position-absolute top-3 start-3 badge text-uppercase tracking-wider px-3 py-2 text-dark"
                              style="background-color: rgba(0,0,0,0.04); border: 1px solid rgba(0,0,0,0.06); font-size: 0.68rem; font-weight: 700; border-radius: 6px; letter-spacing: 0.05em; z-index: 10;">
                            @Model.Category
                        </span>

                        <div class="carousel-inner h-100">
                            <div class="carousel-item active h-100 text-center">
                                <div class="d-flex align-items-center justify-content-center h-100">
                                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/placeholder.png" : Model.ImageUrl)"
                                         alt="@Model.Name"
                                         class="img-fluid core-lens-image"
                                         style="max-height: 100%; object-fit: contain; transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);" />
                                </div>
                            </div>
                        </div>

                        <button class="carousel-control-prev" type="button" data-bs-target="#productAssetCarousel" data-bs-slide="prev" style="width: 10%;">
                            <span class="carousel-control-prev-icon p-3 rounded-circle bg-white bg-opacity-75 border border-dark border-opacity-10" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#productAssetCarousel" data-bs-slide="next" style="width: 10%;">
                            <span class="carousel-control-next-icon p-3 rounded-circle bg-white bg-opacity-75 border border-dark border-opacity-10" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>

                    <div class="p-3 rounded-3 d-flex align-items-center gap-3" style="background: rgba(0,0,0,0.02); border: 1px solid rgba(0,0,0,0.04);">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <span class="small text-muted" style="font-size: 0.85rem; line-height: 1.4; font-weight: 500;">Certified distribution model asset. Inspected and verified enterprise component infrastructure.</span>
                    </div>

                </div>
            </div>

            <div class="col-xl-6 col-lg-6 col-12 d-flex flex-column justify-content-between">
                <div class="product-metadata-header-block">

                    <h1 class="display-5 fw-extrabold text-dark tracking-tight text-capitalize mb-2"
                        style="font-size: 2.8rem; line-height: 1.15;">
                        @Model.Name
                    </h1>

                    <p class="text-muted tracking-wider text-uppercase font-monospace mb-4" style="font-size: 0.8rem; letter-spacing: 0.05em; font-weight: 600;">
                        Asset Reference: <span class="text-dark fw-bold">#026-@Model.Id.ToString("D4")</span>
                    </p>

                    <hr class="my-4" style="border-color: rgba(0,0,0,0.1);" />

                    <div class="valuation-card p-4 rounded-4 mb-4" style="background: #f9f9f9; border: 1px solid rgba(0, 0, 0, 0.06);">
                        <span class="text-uppercase tracking-wider text-muted d-block mb-1" style="font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em;">
                            Acquisition Value
                        </span>
                        <div class="d-flex align-items-baseline gap-2">
                            <span class="fw-extrabold text-dark" style="font-size: 2.4rem; letter-spacing: -0.02em;">
                                @Model.Currency @Model.Price.ToString("N2")
                            </span>
                            <span class="badge bg-success text-white border border-success px-2.5 py-1 rounded-2" style="font-size: 0.72rem; font-weight: 600;">
                                In Stock
                            </span>
                        </div>
                    </div>

                    <div class="mb-5">
                        <h5 class="text-dark text-uppercase tracking-wider mb-3" style="font-size: 0.8rem; font-weight: 700; letter-spacing: 0.05em;">
                            Product Architecture & Overview
                        </h5>
                        <p class="text-muted" style="font-size: 1rem; line-height: 1.7; font-weight: 400; color: #555555 !important;">
                            @Model.Description
                        </p>
                    </div>

                </div>

                <div class="action-dock-panel pt-4 border-top" style="border-color: rgba(0,0,0,0.1) !important;">
                    <div class="row g-3">

                        <div class="col-sm-7 col-12">
                            <a href="/Checkout?productId=@Model.Id"
                               class="btn w-100 py-3 fw-semibold d-flex align-items-center justify-content-center gap-2 custom-prime-btn text-white"
                               style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border: none; border-radius: 8px; font-size: 1rem; box-shadow: 0 8px 24px rgba(245, 158, 11, 0.2); transition: all 0.2s ease;">
                                <i class="bi bi-cart-fill"></i>
                                Initiate Procurement
                            </a>
                        </div>

                        <div class="col-sm-5 col-12">
                            <a href="/Products"
                               class="btn w-100 py-3 fw-medium d-flex align-items-center justify-content-center gap-2 custom-secondary-btn"
                               style="background: rgba(0, 0, 0, 0.02); border: 1px solid rgba(0, 0, 0, 0.08); color: #333333; border-radius: 8px; font-size: 1rem; transition: all 0.2s ease;">
                                <i class="bi bi-arrow-left"></i>
                                Return to Catalog
                            </a>
                        </div>

                    </div>
                </div>

            </div>

        </div>

    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<style>
    .breadcrumb-item + .breadcrumb-item::before {
        color: rgba(0, 0, 0, 0.2) !important;
        content: var(--bs-breadcrumb-divider, "/");
    }

    .breadcrumb-item a {
        transition: color 0.2s ease;
    }

        .breadcrumb-item a:hover {
            color: #f59e0b !important;
        }

    .main-preview-frame:hover .core-lens-image {
        transform: scale(1.03);
    }

    /* Inverted Light Mode Carousel Icons */
    .carousel-control-prev-icon {
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23000'%3e%3cpath d='M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z'/%3e%3c/svg%3e") !important;
    }

    .carousel-control-next-icon {
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23000'%3e%3cpath d='M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z'/%3e%3c/svg%3e") !important;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-size: 50% 50%;
        transition: all 0.2s ease;
    }

    .carousel-control-prev:hover .carousel-control-prev-icon,
    .carousel-control-next:hover .carousel-control-next-icon {
        background-color: #f59e0b !important;
        border-color: #f59e0b !important;
        /* Toggle color to white arrow on hover */
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23fff'%3e%3cpath d='M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z'/%3e%3c/svg%3e") !important;
    }

    .carousel-control-prev:hover .carousel-control-prev-icon {
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23fff'%3e%3cpath d='M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z'/%3e%3c/svg%3e") !important;
    }

    .custom-prime-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(245, 158, 11, 0.35) !important;
        filter: brightness(1.08);
    }

    .custom-prime-btn:active {
        transform: translateY(0);
    }

    .custom-secondary-btn:hover {
        background: rgba(0, 0, 0, 0.05) !important;
        border-color: rgba(0, 0, 0, 0.15) !important;
        color: #000000 !important;
    }

    .fw-extrabold {
        font-weight: 800;
    }

    .top-3 {
        top: 1rem !important;
    }

    .start-3 {
        left: 1rem !important;
    }
</style>