@model List<YellowphaseWebsite.ViewModels.ProductViewModel>

<div class="marketplace-canvas py-5 min-vh-100" style="background: #fafbfc; font-family: 'Inter', system-ui, -apple-system, sans-serif; position: relative; overflow: hidden;">

    <div class="position-absolute top-0 start-0 w-100 h-100"
         style="background-image: linear-gradient(rgba(11, 31, 58, 0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(11, 31, 58, 0.02) 1px, transparent 1px); background-size: 32px 32px; pointer-events: none;">
    </div>

    <div class="container position-relative z-index-1">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-5 gap-3">
            <div>
                <span class="badge fw-semibold px-3 py-2 rounded-pill mb-2 text-uppercase tracking-wider shadow-xs"
                      style="background-color: rgba(11, 31, 58, 0.05); color: #0b1f3a; font-size: 0.7rem;">
                    Storefront
                </span>
                <h1 class="display-5 fw-extrabold m-0 tracking-tight" style="color: #0b1f3a;">Global Logistics Marketplace</h1>
                <p class="text-muted m-0 mt-1" style="font-size: 0.95rem;">Procure certified industrial equipment, components, and enterprise engineering solutions.</p>
            </div>

            <div class="d-flex align-items-center gap-3 bg-white px-4 py-2.5 rounded-3 border shadow-xs" style="border-color: #e2e8f0;">
                <div class="rounded-circle bg-success-subtle d-flex align-items-center justify-content-center" style="width: 10px; height: 10px;">
                    <div class="bg-success rounded-circle" style="width: 6px; height: 6px; animation: pulse 2s infinite;"></div>
                </div>
                <span class="small fw-semibold text-secondary">Showing @Model.Count(x => x.Category != "Commercial Solar") hardware assets globally</span>
            </div>
        </div>

        <div class="card border-0 rounded-4 shadow-sm p-3.5 mb-5" style="background: #ffffff; border: 1px solid rgba(226, 232, 240, 0.8) !important;">
            <form method="get" class="row g-3 align-items-center">

                <div class="col-xl-4 col-lg-3 col-md-12">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted" style="border-color: #e2e8f0; border-radius: 8px 0 0 8px;">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="search" value="@Context.Request.Query["search"]" class="form-control border-start-0 py-2.5 shadow-none custom-input" style="border-color: #e2e8f0; border-radius: 0 8px 8px 0; font-size: 0.95rem; background-color: #f8fafc;" placeholder="Search components, part numbers..." />
                    </div>
                </div>

                <div class="col-xl-3 col-lg-3 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted" style="border-color: #e2e8f0;"><i class="bi bi-tags"></i></span>
                        <select name="category" class="form-select border-start-0 py-2.5 shadow-none custom-input" style="border-color: #e2e8f0; font-size: 0.95rem; background-color: #f8fafc; border-radius: 0 8px 8px 0; cursor: pointer;">
                            <option value="">All Categories</option>
                            @if (ViewBag.Categories != null)
                            {
                                @foreach (var cat in ViewBag.Categories)
                                {
                                    if (cat != "Commercial Solar")
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="col-xl-2 col-lg-2 col-md-4 col-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted small-text" style="border-color: #e2e8f0; font-size:0.85rem; font-weight:600;">ZMW</span>
                        <input type="number" name="minPrice" value="@Context.Request.Query["minPrice"]" class="form-control border-start-0 py-2.5 shadow-none custom-input" style="border-color: #e2e8f0; font-size: 0.95rem; background-color: #f8fafc; border-radius: 0 8px 8px 0;" placeholder="Min Price" />
                    </div>
                </div>

                <div class="col-xl-2 col-lg-2 col-md-4 col-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted small-text" style="border-color: #e2e8f0; font-size:0.85rem; font-weight:600;">ZMW</span>
                        <input type="number" name="maxPrice" value="@Context.Request.Query["maxPrice"]" class="form-control border-start-0 py-2.5 shadow-none custom-input" style="border-color: #e2e8f0; font-size: 0.95rem; background-color: #f8fafc; border-radius: 0 8px 8px 0;" placeholder="Max Price" />
                    </div>
                </div>

                <div class="col-xl-1 col-lg-2 col-md-12">
                    <button type="submit" class="btn text-white w-100 py-2.5 fw-semibold d-flex align-items-center justify-content-center gap-2 filter-trigger"
                            style="background: #0b1f3a; border: none; border-radius: 8px; font-size: 0.95rem; transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);">
                        <i class="bi bi-sliders"></i> <span class="d-lg-none d-xl-inline">Filter</span>
                    </button>
                </div>

            </form>
        </div>

        <div class="row g-4">
            @if (Model == null || !Model.Any(x => x.Category != "Commercial Solar"))
            {
                <div class="col-12 text-center py-5">
                    <div class="p-5 rounded-4 bg-white border border-dashed text-muted" style="border-color: #cbd5e1 !important;">
                        <i class="bi bi-box-seam display-4 mb-3 d-block" style="color: #94a3b8;"></i>
                        <h5 class="fw-bold text-dark">No assets match your active filters</h5>
                        <p class="small mb-0">Try restructuring your keyword strings or tweaking your min/max valuation parameters.</p>
                        <a href="/Products" class="btn btn-sm btn-light border mt-3 px-4 rounded-pill">Reset Catalog Layout</a>
                    </div>
                </div>
            }
            else
            {
                /* Loop updated with inline LINQ to omit items matching the targeted commercial label */
                @foreach (var item in Model.Where(products => products.Category != "Commercial Solar"))
                {
                    <div class="col-xl-4 col-md-6 col-12">
                        <div class="card h-100 product-showcase-card border-0 position-relative"
                             style="background: #ffffff; border-radius: 16px; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); box-shadow: 0 4px 20px rgba(0,0,0,0.02); overflow: hidden; border: 1px solid rgba(226, 232, 240, 0.8) !important;">

                            <div class="position-relative overflow-hidden product-image-wrapper p-3" style="height: 250px; background-color: #f1f5f9;">

                                <span class="position-absolute top-3 start-3 badge text-dark fw-bold px-2.5 py-1.5 shadow-sm"
                                      style="background-color: #ffffff; border: 1px solid #e2e8f0; font-size: 0.72rem; border-radius: 6px; z-index: 2;">
                                    @item.Category
                                </span>

                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder.png" : item.ImageUrl)"
                                     alt="@item.Name"
                                     class="w-100 h-100 product-core-img"
                                     style="object-fit: contain; transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);" />

                                <div class="position-absolute bottom-0 start-0 w-100 h-25" style="background: linear-gradient(to top, rgba(0,0,0,0.01), transparent); pointer-events:none;"></div>
                            </div>

                            <div class="card-body p-4 d-flex flex-column justify-content-between" style="background: #ffffff;">
                                <div>
                                    <h4 class="fw-bold mb-2 product-title text-dark tracking-tight" style="font-size: 1.2rem; transition: color 0.2s ease;">
                                        @item.Name
                                    </h4>
                                    <p class="text-secondary small line-clamp mb-4" style="line-height: 1.5; font-size: 0.88rem;">
                                        @item.Description
                                    </p>
                                </div>

                                <div class="pt-3 border-top d-flex align-items-center justify-content-between"
                                     style="border-color: #f1f5f9 !important;">

                                    <div>
                                        <span class="text-uppercase tracking-wider text-muted d-block"
                                              style="font-size: 0.65rem; font-weight: 700;">
                                            Valuation
                                        </span>
                                        <span class="fw-extrabold fs-5"
                                              style="color: #0b1f3a; letter-spacing: -0.01em;">
                                            @item.Currency @item.Price.ToString("N2")
                                        </span>
                                    </div>

                                    <div class="d-flex gap-2">

                                        <a href="/Products/Details/@item.Id"
                                           class="btn d-flex align-items-center justify-content-center gap-1 rounded-3 px-3 py-2 fw-medium"
                                           style="background: #f8fafc;
                                            border: 1px solid #e2e8f0;
                                            color: #0b1f3a;
                                            font-size: 0.88rem;
                                            transition: all 0.2s ease;">
                                            Details
                                            <i class="bi bi-chevron-right"></i>
                                        </a>

                                        <a href="/Checkout?productId=@item.Id"
                                           class="btn d-flex align-items-center justify-content-center gap-2 rounded-3 px-3 py-2 fw-semibold"
                                           style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
                                            border: none;
                                            color: white;
                                            font-size: 0.88rem;
                                            box-shadow: 0 6px 18px rgba(245, 158, 11, 0.25);">
                                            <i class="bi bi-cart-fill"></i>
                                            Buy Now
                                        </a>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            }
        </div>

    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<style>
    /* Clean CSS Clamp rules preventing multi-line grid pop */
    .line-clamp {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        min-height: 2.7rem;
    }

    /* Input focus transformations matching clean brand specifications */
    .custom-input:focus {
        border-color: #0b1f3a !important;
        background-color: #ffffff !important;
    }

    .input-group:focus-within .input-group-text {
        border-color: #0b1f3a !important;
        background-color: #ffffff !important;
    }

    /* Filter Action Button Hover state variables */
    .filter-trigger:hover {
        background: #061324 !important;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(11, 31, 58, 0.15);
    }

    /* State-Of-The-Art Advanced Showcase Card Interactivity mechanics */
    .product-showcase-card:hover {
        transform: translateY(-5px);
        border-color: rgba(11, 31, 58, 0.15) !important;
        box-shadow: 0 12px 30px rgba(11, 31, 58, 0.05) !important;
    }

        .product-showcase-card:hover .product-core-img {
            transform: scale(1.04);
        }

        .product-showcase-card:hover .product-title {
            color: #f4c542 !important; /* Elegant switch to branding innovation yellow on catalog focus hover */
        }

        .product-showcase-card:hover .action-spec-btn {
            background: #0b1f3a !important;
            border-color: #0b1f3a !important;
            color: #ffffff !important;
        }

        .product-showcase-card:hover .small-icon {
            transform: translateX(3px);
        }

    /* Keyframe Animations */
    @@keyframes pulse {
        0% {
            transform: scale(0.95);
            opacity: 1;
            box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.4);
        }

        70% {
            transform: scale(1);
            opacity: 0.8;
            box-shadow: 0 0 0 6px rgba(25, 135, 84, 0);
        }

        100% {
            transform: scale(0.95);
            opacity: 1;
            box-shadow: 0 0 0 0 rgba(25, 135, 84, 0);
        }
    }

    /* Global Micro Utilities missing inside default systems bootstrap */
    .fw-extrabold {
        font-weight: 800;
    }

    .shadow-xs {
        box-shadow: 0 1px 2px rgba(0,0,0,0.03);
    }

    .p-3.5 {
        padding: 1.15rem !important;
    }

    .top-3 {
        top: 1rem !important;
    }

    .start-3 {
        left: 1rem !important;
    }
</style>